# Copy to .env and fill in. Never commit .env.

# ---------------- Django ----------------
DEBUG=True
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
LOG_LEVEL=INFO

# ---------------- Uploads ----------------
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=100

# ---------------- OCR ----------------
# paddle_local = PaddleOCR on this machine (free, private, CPU)
# nvidia       = NVIDIA-hosted PaddleOCR (needs key below)
OCR_PROVIDER=paddle_local
# Use the PDF's own text when a page has it; OCR only scanned pages.
OCR_USE_PDF_TEXT_LAYER=True
OCR_DPI=200
# pymupdf (no system deps) | poppler (needs poppler; set POPPLER_PATH on Windows)
PDF_RENDERER=pymupdf
POPPLER_PATH=
NVIDIA_OCR_API_URL=https://ai.api.nvidia.com/v1/cv/baidu/paddleocr
NVIDIA_OCR_API_KEY=

# ---------------- LLM ----------------
# ollama = local model (private, free)   gemini = Google cloud (most accurate)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=300
LLM_RETRIES=2
LLM_CHUNK_MAX_CHARS=3500
LLM_CHUNK_OVERLAP_QUESTIONS=0
# Questions per LLM call. Empty = 1 for ollama (small models skip items in long
# lists), unlimited for gemini. Measured: 1 -> 94% recall, ~7 -> 56% (qwen2.5:3b).
LLM_QUESTIONS_PER_CHUNK=

# ---------------- Background jobs ----------------
# thread (default, no infrastructure) | celery (needs Redis + worker)
TASK_BACKEND=thread
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
PROCESSING_STALE_MINUTES=120

# ---------------- Docker ----------------
# Where the container finds Ollama. Default: the Ollama on your computer.
# Use http://ollama:11434 with `docker compose --profile ollama up`.
DOCKER_OLLAMA_BASE_URL=
