# Ignore Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
env/
myenv/
.venv/

# Secrets: never commit real keys. .env.example documents every variable.
.env
.env.*
!.env.example

# Local backups and runtime output
*.backup
logs/

# NOTE: migrations ARE committed. They define the database schema; without
# them a fresh clone cannot run `migrate` and teammates' schemas drift apart.

# Ignore database files (SQLite)
*.sqlite3

# Ignore static files and media uploads (optional)
staticfiles/
media/

# Ignore IDE/editor specific files
.vscode/
.idea/
*.swp

# Ignore logs and local settings
*.log
local_settings.py

# Ignore compiled files
*.so
*.egg-info/
dist/
build/
